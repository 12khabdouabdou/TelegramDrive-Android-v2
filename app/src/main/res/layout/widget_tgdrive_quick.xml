<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="#FFF5F7FA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_subtitle"
            android:textColor="#FF9AA6B8"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_action_search"
            android:textColor="#FFF5F7FA"
            android:backgroundTint="#FF232C3C"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/widget_btn_vault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_action_vault"
            android:textColor="#FFF5F7FA"
            android:backgroundTint="#FF232C3C"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/widget_btn_folders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_action_folders"
            android:textColor="#FFF5F7FA"
            android:backgroundTint="#FF232C3C"
            android:textSize="12sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/widget_btn_backup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/widget_action_backup"
            android:textColor="#FF0D141F"
            android:backgroundTint="#FF64B5F6"
            android:textSize="12sp"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
