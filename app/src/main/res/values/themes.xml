<resources>
    <style name="Theme.TelegramDrive" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme — MUST extend Theme.SplashScreen for installSplashScreen() -->
    <style name="Theme.TelegramDrive.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_root</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TelegramDrive</item>
    </style>
</resources>
